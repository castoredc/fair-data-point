# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999

# The test environment uses its own database so tests never touch dev data.
# All other DB_* values are inherited from .env / .env.dist (note: Symfony
# does not load .env.local when APP_ENV=test).
DB_DEFAULT_NAME=fdp_test
